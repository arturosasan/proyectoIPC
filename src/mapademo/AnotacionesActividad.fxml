<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="mapademo.AnotacionesActividadController"
            prefWidth="1000.0"
            prefHeight="620.0"
            style="-fx-background-color: #17263a;">

    <top>
        <VBox alignment="CENTER"
              spacing="15.0"
              prefHeight="110.0"
              style="-fx-background-color: #17263a; -fx-padding: 35 0 10 0;">

            <Label text="Detalle de actividad"
                   style="-fx-text-fill: white;
                          -fx-font-size: 30px;
                          -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18.0"
              style="-fx-background-color: #17263a;
                     -fx-padding: 0 25 25 45;">

            <Label text="Mapa de la ruta"
                   style="-fx-text-fill: white;
                          -fx-font-size: 18px;
                          -fx-font-weight: bold;"/>

            <Pane fx:id="mapPane"
                  prefWidth="650.0"
                  prefHeight="380.0"
                  style="-fx-background-color: #102033;
                         -fx-border-color: #22d3ee;
                         -fx-border-width: 2.5;
                         -fx-background-radius: 18;
                         -fx-border-radius: 18;">

                <ImageView fx:id="mapImageView"
                           fitWidth="650.0"
                           fitHeight="380.0"
                           preserveRatio="false"/>

                <VBox layoutX="605.0"
                      layoutY="15.0"
                      spacing="5.0">

                    <Button fx:id="btnZoomMas"
                            text="+"
                            prefWidth="30.0"
                            style="-fx-background-color: #102033;
                                   -fx-border-color: #22d3ee;
                                   -fx-text-fill: white;"/>

                    <Button fx:id="btnZoomMenos"
                            text="-"
                            prefWidth="30.0"
                            style="-fx-background-color: #102033;
                                   -fx-border-color: #22d3ee;
                                   -fx-text-fill: white;"/>
                </VBox>
            </Pane>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="280.0"
              spacing="16.0"
              style="-fx-background-color: #17263a;
                     -fx-padding: 20 35 25 15;">

            <VBox spacing="13.0"
                  style="-fx-background-color: #102033;
                         -fx-border-color: #52e0c4;
                         -fx-border-width: 2;
                         -fx-background-radius: 18;
                         -fx-border-radius: 18;
                         -fx-padding: 25 25 25 25;">

                <Label text="Estadísticas"
                       style="-fx-text-fill: white;
                              -fx-font-size: 22px;
                              -fx-font-weight: bold;"/>

                <Label fx:id="lblDistancia"
                       text="Distancia:        -"
                       style="-fx-text-fill: white;
                              -fx-font-size: 14px;"/>

                <Label fx:id="lblDuracion"
                       text="Duración:         -"
                       style="-fx-text-fill: white;
                              -fx-font-size: 14px;"/>

                <Label fx:id="lblVelocidad"
                       text="Velocidad:        -"
                       style="-fx-text-fill: white;
                              -fx-font-size: 14px;"/>

                <Button fx:id="btnAnadirAnotacion"
                        text="Añadir anotación"
                        prefWidth="190.0"
                        style="-fx-background-color: #52e0c4;
                               -fx-text-fill: #102033;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;"/>

                <Label text="Anotaciones"
                       style="-fx-text-fill: white;
                              -fx-font-size: 18px;
                              -fx-font-weight: bold;"/>

                <Label fx:id="lblSinAnotaciones"
                       text="Todavía no hay anotaciones."
                       style="-fx-text-fill: #cfd8e3;
                              -fx-font-size: 13px;"/>

                <ListView fx:id="listaAnotaciones"
                          prefWidth="190.0"
                          prefHeight="130.0"
                          style="-fx-control-inner-background: #102033;
                                 -fx-background-color: #102033;
                                 -fx-border-color: #52e0c4;
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;
                                 -fx-text-fill: white;"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>