<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="363.0" prefWidth="491.0" style="-fx-background-color: #0d1b2a;" stylesheets="@../styles/session.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mapademo.HistorialSesionesController">
   <children>
       <VBox id="sessionContainer" alignment="CENTER" fillWidth="false" prefHeight="289.0" prefWidth="491.0">
         <children>
            <Label alignment="CENTER" style="-fx-text-alignment: center;" styleClass="titleText" text="Historial de sesiones">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <TableView id="tableSession" fx:id="tablaSesiones">
              <columns>
                <TableColumn fx:id="inicioColumn" prefWidth="75.0" text="Inicio" />
                <TableColumn fx:id="finColumn" prefWidth="75.0" text="Fin" />
                  <TableColumn fx:id="duracionColumn" prefWidth="66.0" text="Duración" />
                  <TableColumn fx:id="importadasColumn" prefWidth="75.0" text="Importadas" />
                  <TableColumn fx:id="vistasColumn" prefWidth="71.0" text="Vistas" />
                  <TableColumn fx:id="anotacionesColumn" prefWidth="88.0" text="Anotaciones" />
              </columns>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </TableView>
            <HBox id="total" alignment="CENTER" prefHeight="51.0" prefWidth="491.0" spacing="50.0">
               <children>
                  <Label fx:id="totalImportadasLabel" styleClass="totalLabel" text="Total impportadas:" />
                  <Label fx:id="totalVistasLabel" styleClass="totalLabel" text="Total vistas:" />
                  <Label fx:id="totalAnotacionesLabel" styleClass="totalLabel" text="Total anotaciones:">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Label>
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
      <HBox layoutX="395.0" layoutY="306.0" prefHeight="35.0" prefWidth="69.0">
         <children>
            <Button id="exitButton" mnemonicParsing="false" onAction="#handleSalir" prefHeight="34.0" prefWidth="69.0" text="Salir" />
         </children>
      </HBox>
   </children>
</AnchorPane>
