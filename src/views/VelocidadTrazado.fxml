<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane id="rootBorder" prefHeight="680" prefWidth="950" stylesheets="@../styles/velocidad.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.VelocidadTrazadoController">

    <top>
        <VBox alignment="CENTER" spacing="4" styleClass="top-panel" BorderPane.alignment="CENTER">
            <Label text="Velocidad sobre el trazado" textFill="#55d6b3" VBox.vgrow="ALWAYS">
                <font>
                    <Font name="System Bold" size="30" />
                </font>
            </Label>
            <Label styleClass="subtitle" text="Cada tramo se colorea según la velocidad" textFill="#e8edf5" VBox.vgrow="ALWAYS">
                <VBox.margin>
                    <Insets bottom="10.0" top="5.0" />
                </VBox.margin>
            </Label>
            <BorderPane.margin>
                <Insets top="20.0" />
            </BorderPane.margin>
        </VBox>
    </top>

    <center>
        <BorderPane>
            <center>
                <ScrollPane fx:id="mapScrollPane" hbarPolicy="ALWAYS" pannable="true" vbarPolicy="ALWAYS" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets left="30.0" right="10.0" />
               </BorderPane.margin></ScrollPane>
            </center>
            <right>
                <VBox alignment="CENTER" spacing="0" BorderPane.alignment="CENTER">
                    <Button id="zoom" mnemonicParsing="false" onAction="#zoomIn" stylesheets="@../styles/velocidad.css" text="+">
                        <VBox.margin>
                            <Insets left="10.0" right="10.0" top="30.0" />
                        </VBox.margin>
                    </Button>
                    <Slider fx:id="zoomSlider" orientation="VERTICAL" prefHeight="200.0" prefWidth="16.0">
                        <VBox.margin>
                            <Insets bottom="10.0" top="10.0" />
                        </VBox.margin>
                    </Slider>
                    <Button id="zoom" mnemonicParsing="false" onAction="#zoomOut" stylesheets="@../styles/velocidad.css" text="-">
                        <VBox.margin>
                            <Insets bottom="30.0" left="10.0" right="10.0" />
                        </VBox.margin>
                    </Button>
               <BorderPane.margin>
                  <Insets right="10.0" />
               </BorderPane.margin>
                </VBox>
            </right>
        </BorderPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="10" styleClass="bottom-panel">
            <HBox alignment="CENTER" spacing="22">
                <Label textFill="#e8edf5" />
                <Label text="Lento" textFill="#16c7e8">
               <font>
                  <Font size="16.0" />
               </font></Label>
                <Label text="Medio" textFill="#55d6b3">
               <font>
                  <Font size="16.0" />
               </font></Label>
                <Label text="Rápido" textFill="#ef4264">
               <font>
                  <Font size="16.0" />
               </font></Label>
            </HBox>

            <Label fx:id="infoLabel" text="Pasa el ratón sobre un tramo para ver su velocidad" textFill="#ffffff">
                <VBox.margin>
                    <Insets top="5.0" />
                </VBox.margin>
            </Label>

            <Button id="volver" onAction="#volver" prefHeight="31.0" prefWidth="96.0" stylesheets="@../styles/velocidad.css" text="Volver">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Button>
        </VBox>
    </bottom>

</BorderPane>
