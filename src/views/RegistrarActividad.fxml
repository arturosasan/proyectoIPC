<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            pannable="true"
            style="-fx-background: #1d2a3d; -fx-background-color: #1d2a3d;"
            stylesheets="@../styles/registrar.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.RegistrarActividadController">

    <content>
        <VBox id="rootVBox"
              alignment="TOP_CENTER"
              fillWidth="false"
              minHeight="900"
              spacing="14"
              style="-fx-background-color: #1d2a3d;">

            <padding>
                <Insets top="25" right="45" bottom="60" left="45"/>
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT" prefWidth="900">
                    <Button text="&lt; Volver"
                            onAction="#handleVolver"
                            styleClass="volver-btn"/>
                </HBox>

                <Label text="Registrar actividad" styleClass="app-title"/>

                <HBox alignment="CENTER" spacing="14">
                    <Button text="Seleccionar GPX"
                            onAction="#handleSeleccionarGPX"
                            styleClass="gpx-btn"/>

                    <Label text="Archivo:" styleClass="file-label"/>
                    <Label fx:id="archivoSeleccionadoLabel"
                           text="-"
                           styleClass="file-value"/>
                </HBox>

                <Button text="Importar actividad"
                        onAction="#handleImportarActividad"
                        styleClass="import-btn"/>

                <Label fx:id="estadoLabel"
                       text=""
                       style="-fx-text-fill: #e8edf5; -fx-font-size: 13px;"/>

                <HBox alignment="CENTER" spacing="10">
                    <children>
                        <ScrollPane fx:id="mapScrollPane"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="AS_NEEDED"
                                    pannable="true"
                                    prefHeight="260"
                                    prefWidth="620"
                                    style="-fx-background: #0d1b2a;
                                           -fx-border-color: #16c7e8;
                                           -fx-border-radius: 8;
                                           -fx-background-radius: 8;"/>

                        <VBox alignment="CENTER" spacing="12">
                            <Button text="+"
                                    onAction="#handleZoomIn"
                                    style="-fx-background-color: #55d6b3;
                                           -fx-text-fill: #071323;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 16px;
                                           -fx-background-radius: 8;
                                           -fx-min-width: 42;
                                           -fx-min-height: 42;"/>

                            <Slider fx:id="zoomSlider"
                                    orientation="VERTICAL"
                                    min="0.5"
                                    max="5.0"
                                    value="1.0"
                                    prefHeight="150"/>

                            <Button text="-"
                                    onAction="#handleZoomOut"
                                    style="-fx-background-color: #55d6b3;
                                           -fx-text-fill: #071323;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 16px;
                                           -fx-background-radius: 8;
                                           -fx-min-width: 42;
                                           -fx-min-height: 42;"/>
                        </VBox>
                    </children>
                </HBox>

                <Label fx:id="mapaLabel"
                       text="-"
                       style="-fx-text-fill: #55d6b3;
                              -fx-font-size: 14px;
                              -fx-font-weight: bold;"/>

                <VBox alignment="TOP_CENTER"
                      prefWidth="620"
                      spacing="14"
                      styleClass="stats-panel">

                    <padding>
                        <Insets top="22" right="24" bottom="22" left="24"/>
                    </padding>

                    <children>
                        <Label text="Estadísticas" styleClass="stats-title"/>

                        <GridPane hgap="25" vgap="11">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="180"/>
                                <ColumnConstraints prefWidth="150"/>
                            </columnConstraints>

                            <children>
                                <Label text="Distancia:" styleClass="stat-field"/>
                                <Label fx:id="distanciaLabel" text="-" styleClass="stat-value" GridPane.columnIndex="1"/>

                                <Label text="Duración:" styleClass="stat-field" GridPane.rowIndex="1"/>
                                <Label fx:id="duracionLabel" text="-" styleClass="stat-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Velocidad media:" styleClass="stat-field" GridPane.rowIndex="2"/>
                                <Label fx:id="velocidadLabel" text="-" styleClass="stat-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <Label text="Ritmo medio:" styleClass="stat-field" GridPane.rowIndex="3"/>
                                <Label fx:id="ritmoLabel" text="-" styleClass="stat-value" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                <Label text="Desnivel positivo:" styleClass="stat-field" GridPane.rowIndex="4"/>
                                <Label fx:id="desnivelPositivoLabel" text="-" styleClass="stat-value" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                                <Label text="Desnivel negativo:" styleClass="stat-field" GridPane.rowIndex="5"/>
                                <Label fx:id="desnivelNegativoLabel" text="-" styleClass="stat-value" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                                <Label text="Altitud mínima:" styleClass="stat-field" GridPane.rowIndex="6"/>
                                <Label fx:id="altitudMinimaLabel" text="-" styleClass="stat-value" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                                <Label text="Altitud máxima:" styleClass="stat-field" GridPane.rowIndex="7"/>
                                <Label fx:id="altitudMaximaLabel" text="-" styleClass="stat-value" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                            </children>
                        </GridPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>