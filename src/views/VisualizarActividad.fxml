<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefWidth="1050" prefHeight="690"
            style="-fx-background-color: #162235;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.VisualizarActividadController">

    <top>
        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 12;">
            <HBox alignment="CENTER_LEFT" spacing="30">
                <Button text="&lt; Volver"
                        onAction="#handleVolver"
                        style="-fx-background-color: transparent; -fx-text-fill: #55d6b3; -fx-font-size: 16px; -fx-font-weight: bold;" />

                <Label text="Running la Safor" textFill="#55d6b3">
                    <font>
                        <Font size="34"/>
                    </font>
                </Label>
            </HBox>

            <Label text="Visualizar actividad" textFill="white">
                <font>
                    <Font size="28"/>
                </font>
            </Label>

            <HBox alignment="CENTER" spacing="10">
                <Label text="Actividad:" textFill="white" style="-fx-font-size: 16px;" />

                <ComboBox fx:id="actividadComboBox"
                          onAction="#cambiarActividad"
                          prefWidth="460"
                          prefHeight="38"
                          style="-fx-font-size: 14px;
                                 -fx-background-color: #0f1b2d;
                                 -fx-border-color: #55d6b3;
                                 -fx-border-radius: 10;
                                 -fx-background-radius: 10;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="18" style="-fx-padding: 5 20 10 20;">

            <AnchorPane fx:id="mapPane"
                        prefWidth="760"
                        prefHeight="380"
                        style="-fx-background-color: #0f1b2d;
                               -fx-border-color: #16c7e8;
                               -fx-border-radius: 18;
                               -fx-background-radius: 18;
                               -fx-border-width: 2;" />

            <VBox spacing="15"
                  alignment="TOP_LEFT"
                  prefWidth="220"
                  prefHeight="380"
                  style="-fx-background-color: #081a33;
                         -fx-border-color: #55d6b3;
                         -fx-border-radius: 18;
                         -fx-background-radius: 18;
                         -fx-padding: 20;">

                <Label text="Estadísticas" textFill="white">
                    <font>
                        <Font size="24"/>
                    </font>
                </Label>

                <Label fx:id="distanciaLabel" text="Distancia: -" textFill="white" style="-fx-font-size: 15px;" />
                <Label fx:id="duracionLabel" text="Duración: -" textFill="white" style="-fx-font-size: 15px;" />
                <Label fx:id="velocidadLabel" text="Velocidad: -" textFill="white" style="-fx-font-size: 15px;" />
                <Label fx:id="desnivelLabel" text="Desnivel: -" textFill="white" style="-fx-font-size: 15px;" />

            </VBox>
        </HBox>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="12" style="-fx-padding: 5 0 18 0;">

            <HBox alignment="CENTER" spacing="18">
                <Button text="Perfil de desnivel"
                        onAction="#abrirPerfilDesnivel"
                        prefWidth="260"
                        prefHeight="48"
                        style="-fx-background-color: #55d6b3; -fx-text-fill: #132033; -fx-font-size: 17px; -fx-font-weight: bold; -fx-background-radius: 14;" />

                <Button text="Velocidad sobre trazado"
                        onAction="#abrirVelocidad"
                        prefWidth="260"
                        prefHeight="48"
                        style="-fx-background-color: #55d6b3; -fx-text-fill: #132033; -fx-font-size: 17px; -fx-font-weight: bold; -fx-background-radius: 14;" />

            </HBox>

        </VBox>
    </bottom>

</BorderPane>