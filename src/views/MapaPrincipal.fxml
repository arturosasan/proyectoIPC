<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<BorderPane id="principal" prefHeight="885.0" prefWidth="1275.0" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MapaPrincipalController">
   <top>
      <HBox alignment="CENTER_RIGHT" fillHeight="false" prefHeight="39.0" prefWidth="1263.0" spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Button id="ayuda" mnemonicParsing="false" onAction="#about" stylesheets="@../styles/main.css" text="Ayuda">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </Button>
            <Button id="cambiarMapa" mnemonicParsing="false" onAction="#cambiarMapa" stylesheets="@../styles/main.css" text="Cambiar mapa">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin></Button>
         </children>
         <BorderPane.margin>
            <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
         </BorderPane.margin>
      </HBox>
   </top>
   <bottom>
      <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="mousePosition" minHeight="-Infinity" minWidth="-Infinity" text="X:     Y:     " textFill="WHITE" wrapText="true" HBox.hgrow="ALWAYS" />
         </children>
         <BorderPane.margin>
            <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
         </BorderPane.margin>
      </HBox>
   </bottom>
   <right>
      <VBox prefHeight="556.0" prefWidth="51.0" BorderPane.alignment="CENTER">
         <children>
            <Button id="zoom" mnemonicParsing="false" onAction="#zoomIn" stylesheets="@../styles/main.css" text="+">
               <VBox.margin>
                  <Insets left="12.0" right="10.0" top="30.0" />
               </VBox.margin></Button>
            <Slider fx:id="zoom_slider" orientation="VERTICAL" prefHeight="243.0" prefWidth="16.0">
               <opaqueInsets>
                  <Insets right="10.0" />
               </opaqueInsets>
               <VBox.margin>
                  <Insets left="18.0" top="20.0" />
               </VBox.margin></Slider>
            <Button id="zoom" mnemonicParsing="false" onAction="#zoomOut" stylesheets="@../styles/main.css" text="-">
               <VBox.margin>
                  <Insets left="15.0" right="10.0" top="30.0" />
               </VBox.margin></Button>
         </children>
      </VBox>
   </right>
   <center>
      <ScrollPane fx:id="map_scrollpane" hbarPolicy="ALWAYS" onMouseMoved="#showPosition" pannable="true" prefHeight="398.0" prefWidth="358.0" vbarPolicy="ALWAYS" BorderPane.alignment="CENTER">
         <content>
            <Pane>
               <children>
                  <ImageView pickOnBounds="true">
                     <image>
                        <Image url="@../resources/upv.jpg" />
                     </image>
                  </ImageView>
               </children>
            </Pane>
         </content>
      </ScrollPane>
   </center>
   <left>
      <VBox id="principal" prefHeight="729.0" prefWidth="225.0" stylesheets="@../styles/main.css" BorderPane.alignment="CENTER">
         <children>
             <StackPane prefHeight="150.0" prefWidth="150.0">
                <children>
                   <Circle fill="#1b263b" radius="66.0" stroke="#e94560" strokeType="INSIDE" strokeWidth="3.0" />
                   <ImageView fx:id="avatarView" fitHeight="126.0" fitWidth="126.0" pickOnBounds="true" preserveRatio="false">
                      <clip>
                         <Circle centerX="63.0" centerY="63.0" radius="63.0" />
                      </clip>
                     <image>
                        <Image url="@../resources/icons/user.png" />
                     </image>
                  </ImageView>
               </children>
            </StackPane>
            <Region prefHeight="9.0" prefWidth="225.0" />
            <StackPane prefWidth="225.0">
                <children>
                   <Text fx:id="nicknameText" fill="WHITE" style="-fx-font-size: 22; -fx-font-weight: bold;" textAlignment="CENTER">
                     <StackPane.margin>
                        <Insets left="5.0" />
                     </StackPane.margin></Text>
                </children>
             </StackPane>
            <HBox prefHeight="86.0" prefWidth="225.0">
               <children>
                  <Button id="botonesPerfil" mnemonicParsing="false" onAction="#modificarPerfil" prefHeight="44.0" prefWidth="58.0" stylesheets="@../styles/main.css" textFill="WHITE">
                     <graphic>
                        <ImageView fitHeight="34.0" fitWidth="43.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../resources/icons/edit.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <HBox.margin>
                        <Insets left="45.0" top="20.0" />
                     </HBox.margin>
                  </Button>
                  <Button id="botonesPerfil" mnemonicParsing="false" onAction="#historialSesiones" prefHeight="44.0" prefWidth="62.0" stylesheets="@../styles/main.css">
                     <HBox.margin>
                        <Insets left="20.0" top="20.0" />
                     </HBox.margin>
                     <graphic>
                        <ImageView fitHeight="34.0" fitWidth="37.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../resources/icons/history.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </HBox>
            <Region prefHeight="16.0" prefWidth="225.0" VBox.vgrow="NEVER" />
            <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <SplitPane fx:id="splitPane">
                     <items>
                        <ListView fx:id="map_listview" onMouseClicked="#listClicked" prefHeight="245.0" prefWidth="223.0" />
                     </items>
                  </SplitPane>
               </children>
               <VBox.margin>
                  <Insets left="18.0" right="18.0" />
               </VBox.margin>
            </VBox>
             <Region prefHeight="30.0" prefWidth="225.0" VBox.vgrow="NEVER" />
             <Button id="nuevaActividad" mnemonicParsing="false" onAction="#nuevaActividad" prefHeight="58.0" prefWidth="196.0" stylesheets="@../styles/main.css" text="+ Nueva Actividad">
                <VBox.margin>
                   <Insets left="15.0" />
                </VBox.margin>
             </Button>
             <Region prefHeight="24.0" prefWidth="225.0" VBox.vgrow="NEVER" />
             <Button id="nuevaActividad" mnemonicParsing="false" onAction="#visualizarActividad" prefHeight="58.0" prefWidth="196.0" stylesheets="@../styles/main.css" text="Visualizar Actividad">
                <VBox.margin>
                   <Insets left="15.0" />
                </VBox.margin>
             </Button>
             <Region prefHeight="24.0" prefWidth="225.0" VBox.vgrow="NEVER" />
             <Button id="nuevaActividad" mnemonicParsing="false" onAction="#anotacionesActividad" prefHeight="58.0" prefWidth="196.0" stylesheets="@../styles/main.css" text="Anotaciones">
                <VBox.margin>
                   <Insets left="15.0" />
                </VBox.margin>
             </Button>
             <Region prefHeight="72.0" prefWidth="225.0" VBox.vgrow="ALWAYS" />
            <Button id="cerrarSesion" mnemonicParsing="false" onAction="#cerrarSesion" prefHeight="46.0" prefWidth="153.0" stylesheets="@../styles/main.css" text="Cerrar Sesión" VBox.vgrow="NEVER">
               <VBox.margin>
                  <Insets left="40.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </left>
</BorderPane>
