<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="564.0" prefWidth="1000.0" style="-fx-background-color: #17263a;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AnotacionesActividadController">

    <center>
        <VBox maxWidth="Infinity" prefHeight="406.0" prefWidth="720.0" spacing="18.0" style="-fx-background-color: #17263a; -fx-padding: 0 25 25 45;">

            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Mapa de la ruta" />

            <AnchorPane fx:id="mapPane" VBox.vgrow="ALWAYS" style="-fx-background-color: #102033; -fx-border-color: #22d3ee; -fx-border-width: 2.5; -fx-background-radius: 18; -fx-border-radius: 18;">

                <VBox AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0" spacing="5.0">
                    <Button fx:id="btnZoomMas" prefWidth="30.0" style="-fx-background-color: #102033; -fx-border-color: #22d3ee; -fx-text-fill: white;" text="+" />
                    <Button fx:id="btnZoomMenos" prefWidth="30.0" style="-fx-background-color: #102033; -fx-border-color: #22d3ee; -fx-text-fill: white;" text="-" />
                </VBox>
            </AnchorPane>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="280.0" spacing="16.0" style="-fx-background-color: #17263a; -fx-padding: 20 35 25 15;">

            <VBox VBox.vgrow="ALWAYS" spacing="13.0" style="-fx-background-color: #102033; -fx-border-color: #52e0c4; -fx-border-width: 2; -fx-background-radius: 18; -fx-border-radius: 18; -fx-padding: 25 25 25 25;">

                <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="Estadísticas" />

                <Label fx:id="lblDistancia" style="-fx-text-fill: white; -fx-font-size: 14px;" text="Distancia: -" />
                <Label fx:id="lblDuracion" style="-fx-text-fill: white; -fx-font-size: 14px;" text="Duración: -" />
                <Label fx:id="lblVelocidad" style="-fx-text-fill: white; -fx-font-size: 14px;" text="Velocidad: -" />

                <Button fx:id="btnAnadirAnotacion" maxWidth="Infinity" style="-fx-background-color: #52e0c4; -fx-text-fill: #102033; -fx-font-weight: bold; -fx-background-radius: 8;" text="Añadir anotación" />

                <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Anotaciones" />

                <Label fx:id="lblSinAnotaciones" style="-fx-text-fill: #cfd8e3; -fx-font-size: 13px;" text="Todavía no hay anotaciones." />

                <ListView fx:id="listaAnotaciones" VBox.vgrow="ALWAYS" prefWidth="190.0" style="-fx-control-inner-background: #102033; -fx-background-color: #102033; -fx-border-color: #52e0c4; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: white;" />
            </VBox>
        </VBox>
    </right>

    <top>
        <HBox prefHeight="69.0" prefWidth="1000.0" BorderPane.alignment="CENTER">
            <children>
                <Button maxWidth="104.0" mnemonicParsing="false" onAction="#handleVolver" prefHeight="30.0" prefWidth="104.0" style="-fx-background-color: transparent; -fx-text-fill: #55d6b3; -fx-font-size: 14px; -fx-font-weight: bold; -fx-underline: true;" text="&lt; Volver">
                    <HBox.margin>
                        <Insets left="10.0" top="20.0" />
                    </HBox.margin>
                </Button>
                <Region prefHeight="69.0" prefWidth="226.0" />
                <Label prefHeight="64.0" prefWidth="358.0" style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;" text="Detalles de la actividad">
                    <HBox.margin>
                        <Insets top="10.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>
    </top>

</BorderPane>
